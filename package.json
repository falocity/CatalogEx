{
  "name": "catalogex",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --import tsx --import ./src/instrumentation.mts --watch src/index.ts",
    "start": "node --import ./dist/instrumentation.mjs dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "prepare": "node .husky/install.mjs",
    "build": "tsc --project tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:db": "vitest run --coverage.enabled=false tests/integration/products.integration.test.ts -t 'product footprint API'",
    "test:api": "vitest run --project integration",
    "test:unit": "vitest run --project unit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.2.0",
    "@map-colonies/cleanup-registry": "^1.3.0",
    "@map-colonies/config": "^4.0.1",
    "@map-colonies/js-logger": "^5.0.0",
    "@map-colonies/schemas": "^1.26.0",
    "@map-colonies/tracing": "^1.0.0",
    "@map-colonies/tracing-utils": "^2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "http-status-codes": "^2.3.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@map-colonies/commitlint-config": "^2.0.1",
    "@map-colonies/eslint-config": "^9.0.0",
    "@map-colonies/eslint-plugin": "^1.0.0",
    "@map-colonies/prettier-config": "^1.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
