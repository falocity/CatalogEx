{
  "engines": {
    "node": ">=24 <25"
  },
  "name": "catalogex",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "tsc --project tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "node --env-file-if-exists=.env --import tsx --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:db": "node --env-file-if-exists=.env --import tsx --test \"src/db/**/*.test.ts\" \"tests/integration/db/**/*.test.ts\"",
    "test:api": "node --env-file-if-exists=.env --import tsx --test \"src/modules/**/*.integration.test.ts\" \"tests/integration/*.test.ts\"",
    "test:unit": "node --env-file-if-exists=.env --import tsx --test \"tests/unit/**/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.2.0",
    "@map-colonies/config": "^4.0.1",
    "@map-colonies/js-logger": "^5.0.0",
    "@map-colonies/schemas": "^1.26.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "http-status-codes": "^2.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
